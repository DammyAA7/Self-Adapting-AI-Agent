  smtp_server="smtp.gmail.com",  
  port=587,  
  use_tls=true,  
  username="your.username@gmail.com",  
  password="yourAppPassword",  
  from_address="your.username@gmail.com",  
  to_addresses=["recipient1@example.com", "recipient2@example.com"],  
