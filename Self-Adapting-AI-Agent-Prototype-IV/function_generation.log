    operation="multiply",
    a=[[1, 2], [3, 4]],
    b=[[5, 6], [7, 8]],
    cache_key="mul_2x2",
    use_cache=True
)
print(result_mul)
# Output: [[19, 22], [43, 50]]

# 2. Compute eigenvalues of a matrix, auto-caching by default key
eigs = advanced_matrix_ops(
    operation="eigenvalues",
    a=[[2, 0], [0, 3]]
)
print(eigs)
# Output: [2, 3]
```
