from dataset.patient_records import Hospital, MedicalRecord

def patient_risk_score(hospital: Hospital, patient_id: str) -> float:
    """
    Calculate a risk score for a given patient in a hospital.

    Formula:
      - Age component: (patient.age / 100) * 30
      - Conditions component: patient.get_total_conditions() * 5 * 25/100
      - Severity component: patient.get_average_severity() * 10 * 25/100
      - Abnormal vitals component: +20 if any recent record has abnormal vitals

    Recent records are those within the last 90 days.
    The final score is clamped to [0.0, 100.0].

    Parameters:
    - hospital: Hospital instance (from dataset.patient_records)
    - patient_id: ID of the patient (string)

    Returns:
    - A float risk score between 0.0 and 100.0
    """
    # Retrieve patient
    patient = hospital.get_patient(patient_id)
    if patient is None:
        raise ValueError(f"No patient found with ID '{patient_id}'")

    # Age component
    age_score = (patient.age / 100.0) * 30.0

    # Conditions component
    total_conditions = patient.get_total_conditions()
    conditions_score = total_conditions * 5.0 * 0.25  # 25%

    # Severity component
    avg_severity = patient.get_average_severity()
    severity_score = avg_severity * 10.0 * 0.25        # 25%

    # Abnormal vitals component
    recent_records = hospital.get_recent_records(patient_id, days=90)
    abnormal_flag = any(r.has_abnormal_vitals() for r in recent_records)
    vitals_score = 20.0 if abnormal_flag else 0.0

    # Sum and clamp
    raw_score = age_score + conditions_score + severity_score + vitals_score
    risk = max(0.0, min(raw_score, 100.0))

    return risk

# Example usage:
# from dataset.patient_records import create_sample_hospital
# hosp = create_sample_hospital()
# score = patient_risk_score(hosp, "P001")
# print(f"P001 risk score: {score:.2f}")
```
